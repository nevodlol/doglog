# Оставьте пустым, если фронт и API за одним доменом (reverse proxy на /dogs, /calendar, /uploads).
# VITE_API_BASE_URL=

# Если фронт открывается с одного хоста, а API с другого:
# VITE_API_BASE_URL=https://api.example.com

# Куда проксировать в dev (npm run dev). По умолчанию http://127.0.0.1:8000
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
